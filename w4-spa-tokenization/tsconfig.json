{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@reality/design": ["./design/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "mock/**/*.ts", "design/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
