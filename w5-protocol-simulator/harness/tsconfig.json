{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@reality/protocol": ["../protocol/index.ts"]
    }
  },
  "include": ["**/*.ts", "../protocol/**/*.ts"],
  "exclude": ["node_modules"]
}
