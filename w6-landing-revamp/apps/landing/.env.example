# open-reality-landing — environment
#
# Copy to `.env.local` for local dev (gitignored), and set the same keys in the
# Vercel project (Settings → Environment Variables) for preview/production.
# These three are the ONLY vars this app reads. The Clerk *JWT* verification
# vars (JWKS_URL / ISSUER / AZP) live on the Modal SERVER, not here.

# Clerk — get from the Clerk dashboard (API Keys).
# Use pk_test_/sk_test_ for the dev instance, pk_live_/sk_live_ for production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# The Modal streaming-server broker the dashboard talks to.
# NOTE (bounty kit W6): the production value here encoded a real Modal
# workspace name; replaced with a placeholder subdomain. This var is unused
# in local dev unless you're exercising the /dashboard scan flow (out of
# scope for this kit — see docs/design-brief.md).
NEXT_PUBLIC_MODAL_URL=https://your-modal-workspace--vggt-slam-streaming-web.modal.run
